  Listing app routes would advertise URLs that redirect to sign-in, which is
  noise for a crawler and tells it nothing about the product.
-->
<urlset xmlns="http://www.sitemap.org/schemas/sitemap/0.9">
  <url>
    <loc>https://REPLACE_WITH_YOUR_DOMAIN/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://REPLACE_WITH_YOUR_DOMAIN/privacy</loc>
    <changefreq>monthly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>

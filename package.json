{
  "name": "vitalai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "cd server && npm start",
    "ingest": "cd server && npm run ingest",
    "typecheck": "npm --prefix server run typecheck && npm --prefix client run typecheck",
    "migrate": "npm --prefix server run migrate",
    "lint": "npm --prefix server run lint && npm --prefix client run lint",
    "test": "npm --prefix server test",
    "verify": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}

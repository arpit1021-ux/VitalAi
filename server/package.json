{
  "name": "vitalai-server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "ingest": "tsx src/scripts/ingestKnowledge.ts",
    "check-index": "tsx src/scripts/checkPineconeIndex.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "migrate": "tsx src/scripts/migrate.ts",
    "test:injection": "tsx src/scripts/injectionSuite.ts",
    "test:llm": "tsx src/scripts/smokeLlm.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:watch": "node --import tsx --test --test-concurrency=1 --watch tests/*.test.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.16.1",
    "@google/genai": "^2.9.0",
    "@pinecone-database/pinecone": "^2.0.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.0.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.1.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "sharp": "^0.35.4",
    "vitalai": "file:..",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/mongoose": "^5.11.97",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.5",
    "@types/nodemailer": "^6.4.17",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.16",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.19.0"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "optionalDependencies": {
    "@sentry/node": "^8.47.0"
  }
}

# VitalAI environment.
#
# Copy this file to server/.env (server values) and client/.env (VITE_ values).
# The server validates every entry at boot and refuses to start if one is
# missing or malformed, so there are no silent fallbacks to dev defaults.
#
# Generate secrets with:  openssl rand -hex 32

# ---------------------------------------------------------------- runtime ---
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# --------------------------------------------------------------- database ---
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/vitalai?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/vitalai
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2

# ------------------------------------------------------------------ auth ---
# Both must be at least 32 characters, and must differ from each other.
JWT_SECRET=
JWT_REFRESH_SECRET=

# AES-256 key for health-field encryption: exactly 64 hex characters, and
# different from both JWT secrets.
#
# WARNING: if this key is lost, every encrypted allergy, condition and
# medication becomes unrecoverable. Back it up somewhere separate from the
# database, and never rotate it without re-encrypting first.
ENCRYPTION_KEY=

# ----------------------------------------------------------------- origins ---
# APP_URL      where the browser app is served (used for OAuth redirects)
# API_URL      public base URL of this server (used to build the OAuth callback)
# CORS_ORIGINS comma-separated allowlist of browser origins
APP_URL=http://localhost:5173
API_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------- model ---
# GEMINI_API_KEY is required regardless of provider: embeddings always use Gemini.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Only needed when LLM_PROVIDER=claude.
CLAUDE_API_KEY=
CLAUDE_TEXT_MODEL=claude-sonnet-4-5

# ------------------------------------------------------------ vector store ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=vitalai
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_DIMENSION=1536

# ---------------------------------------------------- image storage (opt.) ---
# Set all three or none. Without them, scans still work; the photo is not kept.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----------------------------------------------------- google oauth (opt.) ---
# Set both or neither. The callback URL is derived as ${API_URL}/api/auth/google/callback
# and must be registered in the Google Cloud console exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------- observability ---
# Error tracking. Optional, but a production deployment without it is one where
# nobody learns about a new exception until a user reports it.
# Install with: npm --prefix server install @sentry/node
SENTRY_DSN=
RELEASE_VERSION=dev

# ------------------------------------------------------ counters and cache ---
# Rate limits, token budgets and the spend ceiling live here. Optional in
# development (an in-process map is used); REQUIRED in production, because
# in-process counters reset on deploy and are not shared between instances.
#
# Leaving any optional setting blank means "unset" — the server does not treat
# an empty value as a malformed one.
REDIS_URL=

# ----------------------------------------------------------- cost controls ---
# Per-user daily token allowance across every AI route. Roughly 5x the modelled
# daily use for an active user.
USER_DAILY_INPUT_TOKENS=150000
USER_DAILY_OUTPUT_TOKENS=40000

# Whole-service daily ceiling in USD. Once crossed, AI routes return a graceful
# message until the next UTC day. The only defence against a bug or an attack
# that a per-user cap cannot see.
DAILY_SPEND_CEILING_USD=25

# Provider prices per million tokens, so spend tracking stays accurate without
# a code change when pricing moves.
PRICE_PER_MTOK_INPUT_USD=0.3
PRICE_PER_MTOK_OUTPUT_USD=2.5

# --------------------------------------------------------------- retention ---
# Scan history and chat transcripts are deleted after this many days by a
# MongoDB TTL index. Changing it takes effect on the next `npm run migrate`.
DATA_RETENTION_DAYS=400

# Version of the privacy notice users consent to. Bumping it requires every
# user to accept again before health data is processed.
CONSENT_VERSION=2026-09-01

# ------------------------------------------------------------------ email ---
# 'log' writes password-reset messages to the application log and delivers
# nothing — development only. Production refuses to start unless this is 'smtp'.
EMAIL_TRANSPORT=log
PASSWORD_RESET_TTL_MINUTES=30

# Required when EMAIL_TRANSPORT=smtp.
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------- client -----
# Goes in client/.env. Must include the /api suffix.
# No model or database credential is ever exposed to the browser.
VITE_API_URL=http://localhost:5000/api

# ------------------------------------------------------------------ tests ---
# Integration tests drop this database on every run, so the name must contain
# "test" — the harness refuses to run against anything else.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/vitalai-test
